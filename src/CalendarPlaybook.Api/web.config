<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- processPath/arguments are filled in by dotnet publish (.\CalendarPlaybook.Api.exe when self-contained). -->
      <!-- If the app fails to start (HTTP 500.30 / 502.5): set stdoutLogEnabled="true", create a "logs" folder next to
           this file, reload the site and read logs\stdout_*.log. Set it back to "false" afterwards. -->
      <aspNetCore stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
