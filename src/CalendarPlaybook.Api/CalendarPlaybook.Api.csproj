<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>bc4ad317-7227-421f-99b0-3451771247d3</UserSecretsId>
    <!-- IIS in-process hosting: IIS starts the app on the first request through web.config (no scripts on the host). -->
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <!-- Ship only the English satellite resources of NuGet packages (drops cs, de, fr, ... folders from publish). -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Development-only files stay out of the hosting folder. -->
  <ItemGroup>
    <Content Update="appsettings.Development.json;dotnet-tools.json" CopyToPublishDirectory="Never" />
    <!-- Shipped to the publish root for deploys: upload it first to stop the app (unlocks DLLs), copy the rest,
         then delete it on the host. Kept out of the project root, where IIS Express would take the app offline. -->
    <None Update="Hosting\app_offline.htm" Link="app_offline.htm" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <!-- Overrides the transitive 9.0.11 from SqlClient: GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <!-- React SPA: dotnet publish builds it (vite mode "hosted", same-origin API) and ships dist/ as wwwroot/.
       Skip with -p:SkipSpaBuild=true (e.g. when CI builds the SPA separately). -->
  <PropertyGroup>
    <SpaRoot>..\CalendarPlaybook.Web\</SpaRoot>
  </PropertyGroup>

  <Target Name="PublishSpa" AfterTargets="ComputeFilesToPublish" Condition="'$(SkipSpaBuild)' != 'true'">
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="npm run build -- --mode hosted" />
    <ItemGroup>
      <SpaDistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(SpaDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!-- Favicon: served from wwwroot at /favicon.ico. Vite does not copy files from the project root, so it is shipped here. -->
  <ItemGroup>
    <None Include="..\CalendarPlaybook.Web\favicon.ico"
          Link="wwwroot\favicon.ico"
          CopyToOutputDirectory="Never"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Legacy seed data (git-ignored personal data). Copied to the build output when present on the build machine,
       but never published: the seed is for local runs only. -->
  <ItemGroup Condition="Exists('..\..\DATA_FROM_OLD_PROJECT\database_backup.json')">
    <None Include="..\..\DATA_FROM_OLD_PROJECT\database_backup.json"
          Link="SeedData\database_backup.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
