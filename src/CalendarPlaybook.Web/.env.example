# Copy to .env.local (not committed). Values come from the cidaas SPA client (Authorization Code + PKCE).
# Tenant URL, e.g. https://your-tenant.cidaas.eu, no trailing slash
VITE_CIDAAS_BASE_URL=
VITE_CIDAAS_CLIENT_ID=
# Optional RFC 8707 resource indicator. Leave empty to use the client id as the token audience.
# Cidaas:Audience in the backend must equal the token aud (this value, or the client id when empty).
VITE_CIDAAS_RESOURCE=
# API base URL, no trailing slash
VITE_API_URL=http://localhost:5101
